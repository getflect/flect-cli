{
  "name": "@dotlabshq/flect-cli",
  "version": "0.3.2",
  "description": "Flect CLI — flect.toml → control plane, and local development",
  "type": "module",
  "bin": {
    "flect": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "flect",
    "cli",
    "deploy",
    "createEnv",
    "libsql",
    "valkey",
    "s3",
    "paas"
  ],
  "homepage": "https://github.com/getflect/flect-cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getflect/flect-cli.git"
  },
  "bugs": {
    "url": "https://github.com/getflect/flect-cli/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "author": "Flect Team",
  "license": "MIT",
  "dependencies": {
    "@baseworks/auth": "^1.0.3",
    "@baseworks/cli": "^0.2.3",
    "@baseworks/iam": "^1.3.0",
    "@baseworks/org": "^2.2.0",
    "commander": "^15.0.0",
    "smol-toml": "^1.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  }
}
